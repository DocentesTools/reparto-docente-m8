# Copy to .env — Docker Compose infrastructure variables.
# `bash init.sh` copies every *.env.example in this directory, including this
# one, so you normally do not copy it by hand.
#
# Application settings go in auth.env, reparto.env, grafana.env and test.env
# (see the matching *.example files). Nothing here is read by a service: these
# values are consumed by the postgres container's init script and by Compose
# interpolation only.
#
# Generate passwords: python -c "import secrets; print(secrets.token_urlsafe(32))"

# ── Optional: Traefik port binding ───────────────────────────────────────────
# The services entryPoint (:9000). Default 127.0.0.1 (localhost only). Set to
# 0.0.0.0 to reach the stack from the LAN — which the meeting and shared-screen
# surfaces need. Also drop the Host() pin in traefik/dynamic_conf.yml and add
# the LAN origin to BACKEND_CORS_ORIGINS in reparto.env.
#API_BIND_IP=127.0.0.1

# ── PostgreSQL superuser (engine bootstrap) ───────────────────────────────────
# Used by the postgres container itself + shared/db_init/init-db.sh to create
# the per-service users below. Do NOT reuse these credentials in auth.env or
# reparto.env — each service gets its own user.
DB_USER=m8_admin
DB_PASSWORD=changethis
DB_PORT=5432

# ── Per-service database isolation ───────────────────────────────────────────
# init-db.sh creates one database + one user per PREFIX_DB_{USER,PASSWORD,NAME}
# triplet on first volume init. Each service then connects with the GENERIC
# DB_DATABASE / DB_USER / DB_PASSWORD names in its own env file — the prefixed
# names below are not a second spelling of those, and the two must agree.
#
# Prefix rules: UPPERCASE, starts with a letter, chars [A-Z0-9_].
# Each *_DB_PASSWORD is validated by the consuming service: >= 8 chars, with
# upper, lower, digit, and special char (no spaces).

# auth_user_service — must match DB_USER / DB_PASSWORD / DB_DATABASE in auth.env.
AUTH_DB_USER=changethis
AUTH_DB_PASSWORD=changethis
AUTH_DB_NAME=auth_db

# reparto_service — must match DB_USER / DB_PASSWORD / DB_DATABASE in reparto.env.
REPARTO_DB_USER=changethis
REPARTO_DB_PASSWORD=changethis
REPARTO_DB_NAME=reparto_db

# ── Redis ─────────────────────────────────────────────────────────────────────
# Only auth_user_service connects to Redis; reparto_service reaches the issuer
# over HTTP (INTROSPECTION_URL) for revocation. Password: >= 8 chars, with
# upper, lower, digit, and special char (no spaces).
REDIS_PASSWORD=changethis

# ── First boot ────────────────────────────────────────────────────────────────
# .env must be fully written BEFORE 'docker compose up' on first boot:
# init-db.sh runs once at volume creation, and later edits do not reprovision.
# To reprovision after a config change, reset the database — see the stack
# README, "Database reset".
